# --- OneAboveAll (OAA) Environment Configuration ---
# Copy to `.env` and adjust. `.env` is git-ignored — never commit secrets.

# Offline Shield: when true, all nodes read deterministic fixtures from
# backend/app/mocks/scenarios.json (zero external API/Docker calls).
MOCK_ENV=true

# LLM provider keys — NOT required while MOCK_ENV=true (clients stay dormant).
# Required only for future live mode.
GROQ_API_KEY=
GOOGLE_API_KEY=

# Blast Radius governance defaults (seeded into runtime_config on first boot;
# afterwards the /config page + PUT /api/v1/config own these values).
BLAST_THRESHOLD=0.40
GLOBAL_MAX_STRIKES=3

# Persistence
DATABASE_PATH=backend/oaa_blackbox.db
CHECKPOINT_DB_PATH=backend/checkpoints.db

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
